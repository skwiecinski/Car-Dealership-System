<Page x:Class="SalonSamochodowy.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="DashboardPage"
      Foreground="White"
      Background="#1A1C23">

    <ScrollViewer Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#5B59E8" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="DocumentAdd24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Nowe zamówienia" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="12" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#5B59E8" Margin="0,0,8,0"/>
                                <TextBlock Text="W procesie" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="10,0,10,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#2D7FF9" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="VehicleCar24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Auta na placu" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="85" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#2D7FF9" Margin="0,0,8,0"/>
                                <TextBlock Text="Do sprzedaży" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="10,0,0,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#2D9A4A" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Wrench24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Zlecenia serwisowe" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="7" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#2D9A4A" Margin="0,0,8,0"/>
                                <TextBlock Text="W toku" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5.5*"/>
                    <ColumnDefinition Width="4.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ranking Sprzedaży (Top 5 Pracowników)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#E2E2E2"/>

                        <lvc:CartesianChart Grid.Row="1" Height="250" 
                                            Series="{Binding SalesSeries}" 
                                            XAxes="{Binding XAxes}" 
                                            YAxes="{Binding YAxes}"
                                            Background="Transparent"
                                            LegendPosition="Hidden" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="10,0,0,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Struktura pojazdów na placu" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#E2E2E2"/>

                        <lvc:PieChart Grid.Row="1" Height="250" 
                                      Series="{Binding VehicleStructureSeries}" 
                                      Background="Transparent"
                                      LegendPosition="Right"
                                      LegendTextPaint="{Binding LegendTextStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Ostatnie aktywności" FontSize="15" FontWeight="SemiBold" Foreground="#E2E2E2" VerticalAlignment="Center"/>
                        <TextBlock Text="Zobacz wszystkie →" Foreground="#5B59E8" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kod zamówienia" Foreground="#8A8D98" Grid.Column="0"/>
                        <TextBlock Text="Klient" Foreground="#8A8D98" Grid.Column="1"/>
                        <TextBlock Text="Pojazd" Foreground="#8A8D98" Grid.Column="2"/>
                        <TextBlock Text="Status" Foreground="#8A8D98" Grid.Column="3"/>
                        <TextBlock Text="Data" Foreground="#8A8D98" Grid.Column="4"/>
                    </Grid>

                    <Separator Background="#2D3038" Margin="0,0,0,10"/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ZAM/2023/10/01" VerticalAlignment="Center" Foreground="White" Grid.Column="0"/>
                        <TextBlock Text="Jan Kowalski" VerticalAlignment="Center" Foreground="White" Grid.Column="1"/>
                        <TextBlock Text="BMW X5 30d" VerticalAlignment="Center" Foreground="White" Grid.Column="2"/>
                        <Border Grid.Column="3" Background="#112C1E" BorderBrush="#2D9A4A" BorderThickness="1" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left">
                            <TextBlock Text="Sfinalizowane" Foreground="#44C767" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="01.10.2023 14:32" VerticalAlignment="Center" Foreground="#8A8D98" Grid.Column="4"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>