<ui:FluentWindow x:Class="SalonSamochodowy.AddClientWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Nowy klient"
                 Height="560" Width="460"
                 WindowStartupLocation="CenterOwner"
                 Background="#16181D"
                 Foreground="White"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <ui:TitleBar Title="Nowy klient" VerticalAlignment="Top" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Margin="32,56,32,24">

            <TextBlock Text="Dodaj nowego klienta"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Wypełnij podstawowe dane. NIP wymagany dla firm."
                       FontSize="12" Foreground="#8A8D98"
                       Margin="0,0,0,20"/>

            <CheckBox x:Name="ChkCompany"
                      Content="Klient firmowy"
                      Margin="0,0,0,16"/>

            <TextBlock Text="Imię i nazwisko / Nazwa firmy" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TxtFullName"
                        PlaceholderText="np. Jan Kowalski lub Firma XYZ Sp. z o.o."
                        Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Telefon" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtPhone"
                                PlaceholderText="+48 600 000 000"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="NIP" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="TxtTaxId"
                                PlaceholderText="1234567890"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="E-mail (wymagany)" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TxtEmail"
                        PlaceholderText="klient@example.com"
                        Margin="0,0,0,28"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Anuluj"
                           Appearance="Secondary"
                           Padding="16,6"
                           Margin="0,0,8,0"
                           Click="CancelBtn_Click"/>
                <ui:Button Content="Zapisz"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Padding="16,6"
                           Click="SaveBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
