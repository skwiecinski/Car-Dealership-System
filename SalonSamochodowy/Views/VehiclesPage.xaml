<Page x:Class="SalonSamochodowy.Views.VehiclesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="VehiclesPage" Foreground="White" Background="#1A1C23">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="FilterPanel" Grid.Column="0" Background="#22242C" CornerRadius="10"
                BorderBrush="#2D3038" BorderThickness="1"
                Padding="20" Margin="0,0,20,0" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Filter24" FontSize="20" Foreground="#5B59E8" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Vehicles_FilterTitle}" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource Vehicles_Brand}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Brands}"
                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                          Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{DynamicResource Vehicles_Model}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{DynamicResource Vehicles_Engine}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Engines}"
                          SelectedItem="{Binding SelectedEngine, Mode=TwoWay}"
                          Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{DynamicResource Vehicles_ColorLabel}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                          Margin="0,0,0,15" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{DynamicResource Vehicles_StatusLabel}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                <ComboBox SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          SelectedIndex="0"
                          Margin="0,0,0,25" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{DynamicResource Vehicles_StatusAll}" Tag="Wszystkie"/>
                    <ComboBoxItem Content="{DynamicResource Vehicles_StatusAvailable}" Tag="Dostępny"/>
                    <ComboBoxItem Content="{DynamicResource Vehicles_StatusReserved}" Tag="Zarezerwowany"/>
                    <ComboBoxItem Content="{DynamicResource Vehicles_StatusSold}" Tag="Sprzedany"/>
                </ComboBox>

                <ui:Button Content="{DynamicResource Vehicles_SearchBtn}" Appearance="Primary"
                           HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Search20}"
                           Command="{Binding SearchCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Vehicles_PageTitle}"
                           FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <ui:Button Grid.Column="1"
                           Content="{DynamicResource Vehicles_AddBtn}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           VerticalAlignment="Center"
                           Command="{Binding OpenAddVehicleCommand}"/>
            </Grid>

            <ScrollViewer x:Name="VehicleScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PreviewMouseWheel="VehicleScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding VehicleList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="320" Background="#22242C" CornerRadius="10"
                                    BorderBrush="#2D3038" BorderThickness="1"
                                    Margin="0,0,20,20" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Border Background="#1C1E23" CornerRadius="8"
                                                Padding="10" HorizontalAlignment="Left">
                                            <ui:SymbolIcon Symbol="VehicleCar24" FontSize="32" Foreground="#8A8D98"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{Binding StatusBackgroundColor}"
                                                BorderBrush="{Binding StatusBorderColor}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusTextColor}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding FullName}"
                                               FontWeight="Bold" FontSize="16"
                                               Foreground="#E2E2E2" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding EngineInfo}"
                                               Foreground="#8A8D98" FontSize="13" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding Color, StringFormat='Kolor: {0}'}"
                                               Foreground="#8A8D98" FontSize="13" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding ExtraFeatures}"
                                               Foreground="#8A8D98" FontSize="11" Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontStyle="Italic"/>

                                    <Separator Background="#2D3038" Margin="0,15,0,15"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Vehicles_VIN}" FontSize="11" Foreground="#8A8D98"/>
                                            <TextBlock Text="{Binding VIN}" FontSize="12"
                                                       Foreground="#E2E2E2" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{DynamicResource Vehicles_RetailPrice}" FontSize="11"
                                                       Foreground="#8A8D98" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Price}" FontSize="16"
                                                       FontWeight="Bold" Foreground="#5B59E8"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Content="{DynamicResource Vehicles_EditBtn}" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Edit24}"
                                                   Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                        <ui:Button Grid.Column="2" Content="{DynamicResource Vehicles_DeleteBtn}" Appearance="Danger"
                                                   HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Delete24}"
                                                   Command="{Binding DataContext.DeleteVehicleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>
                                    
                                    <ui:Button Content="{DynamicResource Vehicles_OrderServiceBtn}" Appearance="Primary" Margin="0,5,0,0"
                                               HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Wrench24}"
                                               Command="{Binding DataContext.OpenAddJobCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
            <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
