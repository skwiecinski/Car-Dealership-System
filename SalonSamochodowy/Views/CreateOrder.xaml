<Page x:Class="SalonSamochodowy.Views.CreateOrder"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SalonSamochodowy.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="Dodaj zamówienie"
      Background="#1A1C23"
      Foreground="White">

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
            <Grid Margin="20,16,20,16" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                <TextBlock Text="{DynamicResource Order_AddTitle}"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Order_AddSubtitle}"
                           FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <ui:Card x:Name="CardClient" Padding="16" Margin="0,0,0,12"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Order_Client}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="RbExistingClient"
                                             Content="{DynamicResource Order_ExistingClient}"
                                             IsChecked="{Binding CzyIstniejacyKlient}"
                                             GroupName="ClientMode" Margin="0,0,16,0"/>
                                <RadioButton x:Name="RbNewClient"
                                             Content="{DynamicResource Order_NewClient}"
                                             GroupName="ClientMode"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbExistingClient, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Order_SelectClient}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ListaKlientow}"
                                          SelectedItem="{Binding WybranyKlient}"
                                          IsEditable="True"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{DynamicResource Order_ClientFilterHint}"
                                           FontSize="11" Opacity="0.5"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=RbNewClient, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Order_FirstName}" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding NowyImie, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Order_LastName}" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding NowyNazwisko, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Order_Email}" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding NowyEmail, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Order_Phone}" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding NowyTelefon, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Order_NIP}" Margin="0,0,0,4"/>
                                        <ui:TextBox Text="{Binding NowyNIP, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Order_ExtraFeatures}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding DodatkoweOpcje}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayNazwa}"
                                                  IsChecked="{Binding Zaznaczona}"
                                                  Margin="0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Order_FeaturesHint}"
                                       FontSize="11" Opacity="0.5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <ui:Card x:Name="CardVehicle" Padding="16" Margin="0,0,0,12"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Order_Vehicle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Order_Brand}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Marki}"
                                              SelectedItem="{Binding WybranaMarka, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Order_Model}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Modele}"
                                              SelectedItem="{Binding WybranyModel, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Order_Trim}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Wersje}"
                                              SelectedItem="{Binding WybranaWersja}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Order_Engine}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Silniki}"
                                              SelectedItem="{Binding WybranySilnik}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Order_Color}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DostępneKolory}"
                                              SelectedItem="{Binding WybranyKolor}"
                                              DisplayMemberPath="FeatureName"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Order_VIN}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding VIN, UpdateSourceTrigger=PropertyChanged}"
                                                MaxLength="17"
                                                HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="{DynamicResource Order_UsedVehicle}"
                                      IsChecked="{Binding CzyUzywany}"
                                      Margin="0,4,0,8"/>

                            <StackPanel Visibility="{Binding CzyUzywany, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Order_Mileage}" Margin="0,0,0,4"/>
                                <ui:NumberBox Value="{Binding Przebieg}"
                                              Minimum="0"
                                              ClearButtonEnabled="False"
                                              HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card x:Name="CardConditions" Padding="16"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Order_Conditions}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Order_OrderDate}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding DataZamowienia}"
                                                HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Order_Seller}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ListaSprzedawcow}"
                                              SelectedItem="{Binding WybranySprzedawca}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Order_PaymentMethod}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FormyPlatnosci}"
                                              SelectedItem="{Binding WybranaFormaPlatnosci}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Order_Status}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding StatusyZamowienia}"
                                              SelectedItem="{Binding WybranyStatus}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Order_Mechanic}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding ListaSerwisantow}"
                                                  SelectedItem="{Binding WybranySerwisant}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Order_FinalPrice}" Margin="0,0,0,4"/>
                            <ui:NumberBox Value="{Binding CenaFinalna}"
                                          Minimum="0"
                                          ClearButtonEnabled="False"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{DynamicResource Order_Notes}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Uwagi, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="80"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

        <Border Grid.Row="1"
                Background="#16181D"
                BorderBrush="#2D3038"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                MinHeight="68"
                HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="{DynamicResource Order_Cancel}"
                           Appearance="Secondary"
                           Padding="20,8"
                           Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"/>
                <ui:Button Content="{DynamicResource Order_Save}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Padding="20,8"
                           Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>

    <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
        <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
            <StackPanel>
                    <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>

    </Grid>
</Page>
