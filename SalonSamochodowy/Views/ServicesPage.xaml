<Page x:Class="SalonSamochodowy.Views.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{DynamicResource Services_PageTitle}" Foreground="White" Background="#1A1C23">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource Services_Title}" FontSize="24" FontWeight="Bold" Foreground="#E2E2E2"/>
                <TextBlock Text="{DynamicResource Services_Subtitle}" Foreground="#8A8D98" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ColPending" Grid.Column="0" Background="#1C1E23" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                <HeaderedItemsControl ItemsSource="{Binding PendingJobs}">
                    <HeaderedItemsControl.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Ellipse Width="8" Height="8" Fill="#8A8D98" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Services_StatusPending}" FontWeight="Bold" Foreground="#8A8D98" FontSize="12" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                        </StackPanel>
                    </HeaderedItemsControl.Header>
                    <HeaderedItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10" Padding="15"
                                     Cursor="Hand"
                                     PreviewMouseLeftButtonUp="JobCard_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTaskName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CarModel}" Foreground="#8A8D98" FontSize="12"/>
                                    <Border Background="#2D3038" CornerRadius="4" Padding="5,2" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding WorkerName}" FontSize="10" Foreground="#E2E2E2"/>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </HeaderedItemsControl.ItemTemplate>
                </HeaderedItemsControl>
            </Border>

            <Border x:Name="ColInProgress" Grid.Column="1" Background="#1C1E23" CornerRadius="12" Margin="10,0,10,0" Padding="15">
                <HeaderedItemsControl ItemsSource="{Binding InProgressJobs}">
                    <HeaderedItemsControl.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Ellipse Width="8" Height="8" Fill="#F0B82B" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Services_StatusInProgress}" FontWeight="Bold" Foreground="#F0B82B" FontSize="12" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                        </StackPanel>
                    </HeaderedItemsControl.Header>
                    <HeaderedItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10" Padding="15" Background="#262218"
                                     Cursor="Hand"
                                     PreviewMouseLeftButtonUp="JobCard_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTaskName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding CarModel}" Foreground="#8A8D98" FontSize="12"/>
                                    <ProgressBar Value="{Binding Progress}" Margin="0,10,0,0" Height="4" Foreground="#F0B82B" Background="#3D3625"/>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </HeaderedItemsControl.ItemTemplate>
                </HeaderedItemsControl>
            </Border>

            <Border x:Name="ColFinished" Grid.Column="2" Background="#1C1E23" CornerRadius="12" Margin="10,0,0,0" Padding="15">
                <HeaderedItemsControl ItemsSource="{Binding FinishedJobs}">
                    <HeaderedItemsControl.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Ellipse Width="8" Height="8" Fill="#44C767" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Services_StatusFinished}" FontWeight="Bold" Foreground="#44C767" FontSize="12" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                        </StackPanel>
                    </HeaderedItemsControl.Header>
                    <HeaderedItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10" Padding="15" Opacity="0.7"
                                     Cursor="Hand"
                                     PreviewMouseLeftButtonUp="JobCard_Click">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayTaskName}" FontWeight="Bold" FontSize="14" TextDecorations="Strikethrough"/>
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#44C767" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding CarModel}" Foreground="#8A8D98" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </HeaderedItemsControl.ItemTemplate>
                </HeaderedItemsControl>
            </Border>
        </Grid>

        <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
            <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
