<Window x:Class="SalonSamochodowy.Views.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nowe Zlecenie Serwisowe" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C23" Foreground="White" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Zleć Usługę Serwisową" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Pojazd" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ui:TextBox Text="{Binding VehicleInfo}" IsReadOnly="True" Margin="0,0,0,15"/>

            <TextBlock Text="Opcja / Usługa" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Features}" SelectedItem="{Binding SelectedFeature}" Margin="0,0,0,15">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding FeatureName}"/>
                            <Run Text=" (" Foreground="#8A8D98"/>
                            <Run Text="{Binding Category}" Foreground="#8A8D98"/>
                            <Run Text=") - " Foreground="#8A8D98"/>
                            <Run Text="{Binding Price, StringFormat={}{0:N0} zł}" Foreground="White" FontWeight="SemiBold"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Serwisant" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox ItemsSource="{Binding Mechanics}" SelectedItem="{Binding SelectedMechanic}" DisplayMemberPath="FullName" Margin="0,0,0,15"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Anuluj" HorizontalAlignment="Stretch" Command="{Binding CancelCommand}"/>
            <ui:Button Grid.Column="2" Content="Zapisz" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</Window>
