<ui:FluentWindow x:Class="SalonSamochodowy.Views.EditClientWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SalonSamochodowy.Views"
                 Title="Edytuj dane klienta"
                 Height="560" Width="460"
                 WindowStartupLocation="CenterOwner"
                 Background="#16181D"
                 Foreground="White"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <ui:TitleBar Title="Edytuj dane klienta" VerticalAlignment="Top"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Margin="32,56,32,24">

            <TextBlock Text="{DynamicResource Clients_EditHeader}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Clients_EditDesc}"
                       FontSize="12" Foreground="#8A8D98" Margin="0,0,0,20"/>

            <CheckBox Content="{DynamicResource Clients_IsCompany}"
                      IsChecked="{Binding IsCompany, Mode=TwoWay}"
                      Margin="0,0,0,16"/>

            <TextBlock Text="{DynamicResource Clients_ColName}"
                       Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="{DynamicResource Clients_NameHint}"
                        Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Clients_ColPhone}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="+48 600 000 000"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Clients_ColNIP}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="1234567890"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Clients_ColEmail}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="klient@example.com"
                        Margin="0,0,0,28"/>

            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#ED6262" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorVisibility}"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Clients_Cancel}"
                           Appearance="Secondary"
                           Padding="16,6" Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"/>
                <ui:Button Content="{DynamicResource Clients_SaveChanges}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Padding="16,6"
                           Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
