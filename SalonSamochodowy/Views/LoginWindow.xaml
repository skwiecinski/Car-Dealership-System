<ui:FluentWindow x:Class="SalonSamochodowy.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Login_Title}" Height="500" Width="420"
                 WindowStartupLocation="CenterScreen"
                 Background="#16181D"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="SingleBorderWindow"
                 Opacity="0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" />
                    <ThicknessAnimation Storyboard.TargetProperty="Margin" Storyboard.TargetName="MainContentGrid" From="0,20,0,-20" To="0,0,0,0" Duration="0:0:0.6">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid x:Name="MainContentGrid">
        <ui:TitleBar Title="{DynamicResource Login_Header}" VerticalAlignment="Top" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,50,20,0" Panel.ZIndex="100">
            <Button x:Name="LangPlBtn" Click="LangPl_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" ToolTip="Polski" Cursor="Hand">
                <Border Width="30" Height="20" CornerRadius="3" ClipToBounds="True" BorderBrush="#5B59E8" BorderThickness="1">
                    <Grid Background="Transparent">
                        <Rectangle Fill="White" Height="10" VerticalAlignment="Top"/>
                        <Rectangle Fill="#DC143C" Height="10" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Button>

            <Button x:Name="LangEnBtn" Click="LangEn_Click" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="English" Cursor="Hand" Opacity="0.4">
                <Border Width="30" Height="20" CornerRadius="3" ClipToBounds="True" BorderBrush="#2D3038" BorderThickness="1">
                    <Grid Background="Transparent">
                        <Rectangle Fill="White"/>
                        <StackPanel>
                            <Rectangle Fill="#B22234" Height="3.33"/>
                            <Rectangle Fill="White" Height="3.33"/>
                            <Rectangle Fill="#B22234" Height="3.33"/>
                            <Rectangle Fill="White" Height="3.33"/>
                            <Rectangle Fill="#B22234" Height="3.33"/>
                            <Rectangle Fill="White" Height="3.33"/>
                        </StackPanel>
                        <Rectangle Fill="#3C3B6E" Width="12" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Button>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" Margin="40,20,40,0">
            <ui:SymbolIcon Symbol="VehicleCar24" FontSize="54" Foreground="#5B59E8" Margin="0,0,0,15"/>
            <TextBlock Text="{DynamicResource Login_Header}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="{DynamicResource Login_Subtitle}" FontSize="14" Foreground="#8A8D98" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="{DynamicResource Login_Email}" Foreground="#8A8D98" Margin="0,0,0,8" FontSize="12"/>
            <ui:TextBox x:Name="TxtUsername"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="user@dealership.com"
                        Icon="{ui:SymbolIcon Person24}"
                        Margin="0,0,0,20"/>

            <TextBlock Text="{DynamicResource Login_Password}" Foreground="#8A8D98" Margin="0,0,0,8" FontSize="12"/>
            <ui:PasswordBox x:Name="TxtPassword"
                            PlaceholderText="••••••••"
                            Icon="{ui:SymbolIcon LockClosed24}"
                            Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#ED6262"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <ui:Button Content="{DynamicResource Login_Button}"
                       Appearance="Primary"
                       HorizontalAlignment="Stretch"
                       Height="45"
                       FontSize="15"
                       FontWeight="SemiBold"
                       IsDefault="True"
                       Command="{Binding LoginCommand}"
                       CommandParameter="{Binding ElementName=TxtPassword}"/>

            <ui:Button Content="{DynamicResource Login_Exit}"
                       Appearance="Transparent"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Foreground="#8A8D98"
                       Command="{Binding ExitCommand}"/>
        </StackPanel>
        </Grid>

        <!-- Ekran ładowania -->
        <Grid x:Name="LoadingOverlay" Background="#D916181D" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="200">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" Foreground="#5B59E8" />
                <TextBlock Text="Logowanie..." Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</ui:FluentWindow>
