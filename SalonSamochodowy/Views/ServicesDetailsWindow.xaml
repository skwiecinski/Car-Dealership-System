<ui:FluentWindow
    x:Class="SalonSamochodowy.Views.ServicesDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource ServicesDetails_Title}"
    Width="620" Height="660"
    MinWidth="560" MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Kolory -->
        <SolidColorBrush x:Key="BgBase"      Color="#0F1117"/>
        <SolidColorBrush x:Key="BgSurface"   Color="#161B27"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1C2235"/>
        <SolidColorBrush x:Key="BorderColor" Color="#252D40"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF0F8"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7299"/>
        <SolidColorBrush x:Key="Accent"      Color="#5B59E8"/>

        <!-- Reużywalny styl wiersza info -->
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Etykieta -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Wartość -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Nagłówek sekcji -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <!-- Karta sekcji -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="18,16"/>
            <Setter Property="Margin"           Value="0,0,0,10"/>
        </Style>

        <!-- Przycisk statusu -->
        <Style x:Key="StatusBtn" TargetType="Button">
            <Setter Property="Height"      Value="38"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource BgBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- titlebar -->
            <RowDefinition Height="*"/>
            <!-- content -->
        </Grid.RowDefinitions>

        <!-- ── Custom TitleBar ────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="{StaticResource BgSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="{StaticResource Accent}" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource ServicesDetails_Header}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" · "
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding JobCode}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13" FontFamily="Segoe UI Mono"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ui:TitleBar Grid.Column="1"
                         ShowMinimize="False" ShowMaximize="False"
                         VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Scrollable content ─────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,20">
            <StackPanel>

                <!-- STATUS BADGE + data -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ServicesDetails_Created}" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding CreatedAt}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{Binding StatusBadgeBackground}"
                            BorderBrush="{Binding StatusBadgeBorder}"
                            BorderThickness="1" CornerRadius="20"
                            Padding="16,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentStatus}"
                                   Foreground="{Binding StatusBadgeForeground}"
                                   FontSize="12" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"/>
                    </Border>
                </Grid>

                <!-- CZYNNOŚĆ / WYPOSAŻENIE -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ServicesDetails_ServiceAction}" Style="{StaticResource SectionHeader}"/>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_Equipment}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding FeatureName}"
                                       Style="{StaticResource ValueStyle}"
                                       FontSize="15" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_Category}" Style="{StaticResource LabelStyle}"/>
                            <Border Background="#252D40" CornerRadius="6" Padding="10,4"
                                    HorizontalAlignment="Left" Grid.Column="1">
                                <TextBlock Text="{Binding FeatureCategory}"
                                           Foreground="#8A8EAD" FontSize="12" FontFamily="Segoe UI"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- POJAZD -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ServicesDetails_Vehicle}" Style="{StaticResource SectionHeader}"/>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Vehicles_ModelLabel}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding VehicleModel}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Vehicles_Engine}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding VehicleEngine}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Vehicles_VIN}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding VehicleVin}"
                                       Style="{StaticResource ValueStyle}"
                                       FontFamily="Segoe UI Mono" FontSize="12"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_VehicleStatus}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding VehicleStatus}"
                                       Style="{StaticResource ValueStyle}"
                                       Foreground="#8A8EAD"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SERWISANT -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ServicesDetails_MechanicInfo}" Style="{StaticResource SectionHeader}"/>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_FullName}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WorkerName}"
                                       Style="{StaticResource ValueStyle}"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Style="{StaticResource InfoRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_Email}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding WorkerEmail}"
                                       Style="{StaticResource ValueStyle}"
                                       Foreground="#8A8EAD"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ServicesDetails_Dealership}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DealershipName}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ZMIANA STATUSU -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ServicesDetails_ChangeStatus}" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Oczekujące -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource StatusBtn}"
                                    Command="{Binding SetPendingCommand}"
                                    IsEnabled="{Binding CanMoveToPending}"
                                    Background="#332A12" BorderBrush="#D3A125"
                                    Foreground="#F0B82B"
                                    Content="{DynamicResource ServicesDetails_SetPending}"/>

                            <!-- W trakcie -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource StatusBtn}"
                                    Command="{Binding SetInProgressCommand}"
                                    IsEnabled="{Binding CanMoveToInProgress}"
                                    Background="#1A2540" BorderBrush="#3B82F6"
                                    Foreground="#60A5FA"
                                    Content="{DynamicResource ServicesDetails_SetInProgress}"/>

                            <!-- Zakończone -->
                            <Button Grid.Column="4"
                                    Style="{StaticResource StatusBtn}"
                                    Command="{Binding SetFinishedCommand}"
                                    IsEnabled="{Binding CanMoveToFinished}"
                                    Background="#112C1E" BorderBrush="#2D9A4A"
                                    Foreground="#44C767"
                                    Content="{DynamicResource ServicesDetails_SetFinished}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ZAMKNIJ -->
                <Button Command="{Binding CloseCommand}"
                        Height="44" Margin="0,4,0,0"
                        Background="#252D40" BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseButtonBorder" Property="Background" Value="#2E3754"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{DynamicResource Global_Close}" Foreground="{StaticResource TextMuted}"
                               FontSize="13" FontFamily="Segoe UI"/>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
