<Page x:Class="SalonSamochodowy.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ReportsPage" Foreground="White" Background="#1A1C23">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Reports_Title}" FontSize="24" FontWeight="Bold" Foreground="#E2E2E2"/>
                <TextBlock Text="{DynamicResource Reports_Subtitle}" Foreground="#8A8D98" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Reports_Period}" Foreground="#8A8D98" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding AvailablePeriods}" 
                          SelectedIndex="{Binding SelectedPeriodIndex, Mode=TwoWay}"
                          Width="200"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ReportsPanel" Orientation="Horizontal" ItemWidth="300">
                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="32" Foreground="#5B59E8" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_OrderStatusTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_OrderStatusDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateOrdersReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Person24" FontSize="32" Foreground="#ED6262" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_ClientPurchasesTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_ClientPurchasesDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        
                        <ComboBox ItemsSource="{Binding AvailableClients}" 
                                  SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                  DisplayMemberPath="Display"
                                  Margin="0,0,0,15" />

                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateClientReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="DataBarHorizontal24" FontSize="32" Foreground="#4CAF50" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_SalesRankingsTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_SalesRankingsDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateRankingsReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Database24" FontSize="32" Foreground="#FF9800" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_FullDumpTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_FullDumpDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateFullDumpReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Money24" FontSize="32" Foreground="#8BC34A" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_FinancialReportTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_FinancialReportDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateFinancialReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="VehicleCar24" FontSize="32" Foreground="#03A9F4" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_TrendsReportTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_TrendsReportDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateTrendsReportCommand}"/>
                    </StackPanel>
                </Border>

                
                <Border Background="#22242C" CornerRadius="10" Padding="20" Margin="0,0,20,20" BorderBrush="#2D3038" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Wrench24" FontSize="32" Foreground="#9C27B0" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{DynamicResource Reports_ServiceReportTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource Reports_ServiceReportDesc}" 
                                   Foreground="#8A8D98" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <ui:Button Content="{DynamicResource Reports_GeneratePDF}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding GenerateServiceReportCommand}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
            <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
