<Page x:Class="SalonSamochodowy.Views.SalesRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SalonSamochodowy.Views"
      Title="Ewidencja Sprzedaży" Foreground="White" Background="#1A1C23">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- Table -->
            <RowDefinition Height="Auto"/>
            <!-- Summary -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Ewidencja Sprzedaży" FontSize="24" FontWeight="Bold" Foreground="#E2E2E2"/>
                <TextBlock Text="Rejestr wszystkich transakcji: pojazd, klient, doradca i salon" Foreground="#8A8D98" Margin="0,4,0,0"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Width="100" Height="4"
                         Foreground="#5B59E8" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- ===== Filters ===== -->
        <Border x:Name="FiltersSection" Grid.Row="1" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Salon" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DealershipFilters}" SelectedItem="{Binding SelectedDealership, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Doradca" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AdvisorFilters}" SelectedItem="{Binding SelectedAdvisor, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Od" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="130"/>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="Do" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="130"/>
                </StackPanel>

                <ui:Button Grid.Column="10" Content="Wyczyść" Appearance="Secondary"
                           VerticalAlignment="Bottom" Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding ClearFiltersCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Table ===== -->
        <Border x:Name="TableSection" Grid.Row="2" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="8">
            <Grid>
                <DataGrid ItemsSource="{Binding Records}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          Foreground="White"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowBackground="Transparent" AlternatingRowBackground="#1C1E23"
                          HorizontalGridLinesBrush="#1AFFFFFF"
                          CanUserAddRows="False" SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod"     Binding="{Binding OrderCode}"      Width="Auto"/>
                        <DataGridTextColumn Header="Data"    Binding="{Binding OrderDateText}"  Width="Auto"/>
                        <DataGridTextColumn Header="Pojazd"  Binding="{Binding VehicleName}"    Width="*"/>
                        <DataGridTextColumn Header="VIN"     Binding="{Binding Vin}"            Width="Auto" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="Klient"  Binding="{Binding ClientName}"     Width="*"/>
                        <DataGridTextColumn Header="Doradca" Binding="{Binding AdvisorName}"    Width="*"/>
                        <DataGridTextColumn Header="Salon"   Binding="{Binding DealershipName}" Width="*"/>
                        <DataGridTemplateColumn Header="Status" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" Margin="2"
                                            Background="#1C1E23" BorderThickness="1"
                                            BorderBrush="{Binding StatusColor}">
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kwota" Binding="{Binding FinalPriceText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#44C767"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Brak transakcji spełniających kryteria"
                           Foreground="#8A8D98" FontSize="14" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Visibility="{Binding EmptyVisibility}"/>
            </Grid>
        </Border>

        <!-- ===== Summary ===== -->
        <Border x:Name="SummarySection" Grid.Row="3" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="16,10" Margin="0,16,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="#E2E2E2" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </Border>

        <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
            <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <TextBlock x:Name="TourText" Text="Tekst samouczka" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="Dalej" Appearance="Primary" Click="TourNext_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
