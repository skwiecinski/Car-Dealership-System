<Page x:Class="SalonSamochodowy.Views.SalesRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SalonSamochodowy.Views"
      Title="Ewidencja Sprzedaży" Foreground="White" Background="#1A1C23">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- Table -->
            <RowDefinition Height="Auto"/>
            <!-- Summary -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource SalesRecords_Title}" FontSize="24" FontWeight="Bold" Foreground="#E2E2E2"/>
                <TextBlock Text="{DynamicResource SalesRecords_Subtitle}" Foreground="#8A8D98" Margin="0,4,0,0"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Width="100" Height="4"
                         Foreground="#5B59E8" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- ===== Filters ===== -->
        <Border x:Name="FiltersSection" Grid.Row="1" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource SalesRecords_Status}" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource SalesRecords_Dealership}" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DealershipFilters}" SelectedItem="{Binding SelectedDealership, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="{DynamicResource SalesRecords_Advisor}" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AdvisorFilters}" SelectedItem="{Binding SelectedAdvisor, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="{DynamicResource SalesRecords_DateFrom}" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="130"/>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="{DynamicResource SalesRecords_DateTo}" Foreground="#8A8D98" FontSize="11" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="130"/>
                </StackPanel>

                <ui:Button Grid.Column="10" Content="{DynamicResource SalesRecords_ClearFilters}" Appearance="Secondary"
                           VerticalAlignment="Bottom" Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding ClearFiltersCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Table ===== -->
        <Border x:Name="TableSection" Grid.Row="2" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="8">
            <Grid>
                <DataGrid ItemsSource="{Binding Records}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          Foreground="White"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowBackground="Transparent" AlternatingRowBackground="#1C1E23"
                          HorizontalGridLinesBrush="#1AFFFFFF"
                          CanUserAddRows="False" SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColCode}"     Binding="{Binding OrderCode}"      Width="Auto"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColDate}"    Binding="{Binding OrderDateText}"  Width="Auto"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColVehicle}"  Binding="{Binding VehicleName}"    Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColVIN}"     Binding="{Binding Vin}"            Width="Auto" FontFamily="Consolas"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColClient}"  Binding="{Binding ClientName}"     Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColAdvisor}" Binding="{Binding AdvisorName}"    Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColDealership}"   Binding="{Binding DealershipName}" Width="*"/>
                        <DataGridTemplateColumn Header="{DynamicResource SalesRecords_ColStatus}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" Margin="2"
                                            Background="#1C1E23" BorderThickness="1"
                                            BorderBrush="{Binding StatusColor}">
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource SalesRecords_ColPrice}" Binding="{Binding FinalPriceText}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#44C767"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{DynamicResource SalesRecords_NoRecords}"
                           Foreground="#8A8D98" FontSize="14" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Visibility="{Binding EmptyVisibility}"/>
            </Grid>
        </Border>

        <!-- ===== Summary ===== -->
        <Border x:Name="SummarySection" Grid.Row="3" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="16,10" Margin="0,16,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="#E2E2E2" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        </Border>

        <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
            <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
                <StackPanel>
                    <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
