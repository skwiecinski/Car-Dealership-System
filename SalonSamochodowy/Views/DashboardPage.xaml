<Page x:Class="SalonSamochodowy.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="DashboardPage"
      Foreground="White"
      Background="#1A1C23">

    <Grid>
        <ScrollViewer Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="BorderOrders" Grid.Column="0" Margin="0,0,10,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#5B59E8" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="DocumentAdd24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="{DynamicResource Dash_NewOrders}" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="{Binding KpiOrders}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#5B59E8" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Dash_InProcess}" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BorderVehicles" Grid.Column="1" Margin="10,0,10,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#2D7FF9" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="VehicleCar24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="{DynamicResource Dash_CarsOnLot}" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="{Binding KpiVehicles}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#2D7FF9" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Dash_ForSale}" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BorderJobs" Grid.Column="2" Margin="10,0,0,0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="12" Background="#2D9A4A" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="Wrench24" Foreground="White" FontSize="28"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="{DynamicResource Dash_ServiceJobs}" FontSize="15" Foreground="#E2E2E2"/>
                            <TextBlock Text="{Binding KpiJobs}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#2D9A4A" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Dash_InProgress}" FontSize="13" Foreground="#8A8D98"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="BorderChart" Margin="0,0,0,20" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding SalesChartTitle}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#E2E2E2"/>

                    <lvc:CartesianChart Grid.Row="1" Height="250"
                                        Series="{Binding SalesSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        Background="Transparent"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>

            <Border Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="{DynamicResource Dash_RecentActivities}" FontSize="15" FontWeight="SemiBold" Foreground="#E2E2E2" VerticalAlignment="Center"/>
                        <ui:Button Content="{DynamicResource Dash_SeeAll}" Appearance="Transparent" Foreground="#5B59E8" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0" BorderThickness="0" FocusVisualStyle="{x:Null}" Click="SeeAllOrders_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Dash_OrderCode}" Foreground="#8A8D98" Grid.Column="0"/>
                        <TextBlock Text="{DynamicResource Dash_Client}" Foreground="#8A8D98" Grid.Column="1"/>
                        <TextBlock Text="{DynamicResource Dash_Vehicle}" Foreground="#8A8D98" Grid.Column="2"/>
                        <TextBlock Text="{DynamicResource Dash_Status}" Foreground="#8A8D98" Grid.Column="3"/>
                        <TextBlock Text="{DynamicResource Dash_Date}" Foreground="#8A8D98" Grid.Column="4"/>
                    </Grid>

                    <Separator Background="#2D3038" Margin="0,0,0,10"/>

                    <TextBlock Text="{DynamicResource Dash_NoRecentOrders}"
                               Foreground="#8A8D98" FontSize="12" FontStyle="Italic"
                               HorizontalAlignment="Center" Margin="0,16,0,8"
                               Visibility="{Binding EmptyOrdersVisibility}"/>

                    <ItemsControl ItemsSource="{Binding RecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OrderCode}"  VerticalAlignment="Center" Foreground="White"   Grid.Column="0"/>
                                    <TextBlock Text="{Binding ClientName}" VerticalAlignment="Center" Foreground="White"   Grid.Column="1"/>
                                    <TextBlock Text="{Binding Vehicle}"    VerticalAlignment="Center" Foreground="White"   Grid.Column="2"/>
                                    <Border Grid.Column="3"
                                            Background="{Binding StatusBackground}"
                                            BorderBrush="{Binding StatusBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusForeground}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Date}" VerticalAlignment="Center" Foreground="#8A8D98" Grid.Column="4"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <Popup x:Name="TourPopup" AllowsTransparency="True" StaysOpen="True" Placement="Bottom">
        <Border Background="#2D3038" BorderBrush="#5B59E8" BorderThickness="2" CornerRadius="8" Padding="15" Width="280">
            <StackPanel>
                <TextBlock x:Name="TourText" Text="{DynamicResource Tour_DefaultText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="TourNextBtn" Content="{DynamicResource Tour_Next}" Appearance="Primary" Click="TourNext_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Page>