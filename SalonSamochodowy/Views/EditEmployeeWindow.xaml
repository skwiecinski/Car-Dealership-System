<ui:FluentWindow x:Class="SalonSamochodowy.Views.EditEmployeeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Admin_EditEmployeeTitle}"
                 Height="650" Width="460"
                 WindowStartupLocation="CenterOwner"
                 Background="#16181D"
                 Foreground="White"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <ui:TitleBar Title="{DynamicResource Admin_EditEmployeeTitle}" VerticalAlignment="Top"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Margin="32,56,32,24">

            <TextBlock Text="{DynamicResource Admin_EditEmployeeTitle}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Admin_EditEmployeeSubtitle}"
                       FontSize="12" Foreground="#8A8D98" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Admin_FirstName}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Admin_LastName}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Admin_Email}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12"/>

            <TextBlock Text="{DynamicResource Admin_Role}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox Margin="0,0,0,12"
                      ItemsSource="{Binding AvailableRoles}"
                      SelectedItem="{Binding RoleName, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="Sprzedawca">
                                            <Setter Property="Text" Value="{DynamicResource Role_Salesman}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Serwisant">
                                            <Setter Property="Text" Value="{DynamicResource Role_Mechanic}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Kierownik">
                                            <Setter Property="Text" Value="{DynamicResource Role_Manager}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Administrator">
                                            <Setter Property="Text" Value="{DynamicResource Role_Admin}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{DynamicResource Admin_DealershipRequired}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox Margin="0,0,0,12"
                      ItemsSource="{Binding AvailableDealerships}"
                      SelectedItem="{Binding SelectedDealership, Mode=TwoWay}"/>

            <TextBlock Text="{DynamicResource Admin_NewPassword}" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:PasswordBox PasswordChanged="PasswordBox_PasswordChanged"
                            PlaceholderText="••••••••"
                            Margin="0,0,0,28"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#ED6262" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorVisibility}"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Global_Cancel}"
                           Appearance="Secondary"
                           Padding="16,6" Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"/>
                <ui:Button Content="{DynamicResource Global_SaveChanges}"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Padding="16,6"
                           Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
