<ui:FluentWindow x:Class="SalonSamochodowy.Views.EditEmployeeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edytuj dane pracownika"
                 Height="650" Width="460"
                 WindowStartupLocation="CenterOwner"
                 Background="#16181D"
                 Foreground="White"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <ui:TitleBar Title="Edytuj dane pracownika" VerticalAlignment="Top"
                     ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Margin="32,56,32,24">

            <TextBlock Text="Edytuj dane pracownika"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Zaktualizuj dane personalne, rolę oraz opcjonalnie hasło."
                       FontSize="12" Foreground="#8A8D98" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Imię" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nazwisko" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="E-mail (login)" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12"/>

            <TextBlock Text="Rola w systemie" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox Margin="0,0,0,12"
                      ItemsSource="{Binding AvailableRoles}"
                      SelectedItem="{Binding RoleName, Mode=TwoWay}"/>

            <TextBlock Text="Salon (wymagany dla pracowników)" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox Margin="0,0,0,12"
                      ItemsSource="{Binding AvailableDealerships}"
                      SelectedItem="{Binding SelectedDealership, Mode=TwoWay}"/>

            <TextBlock Text="Nowe hasło (pozostaw puste, by nie zmieniać)" Foreground="#8A8D98" FontSize="12" Margin="0,0,0,4"/>
            <ui:PasswordBox PasswordChanged="PasswordBox_PasswordChanged"
                            PlaceholderText="••••••••"
                            Margin="0,0,0,28"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#ED6262" FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorVisibility}"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Anuluj"
                           Appearance="Secondary"
                           Padding="16,6" Margin="0,0,8,0"
                           Command="{Binding CancelCommand}"/>
                <ui:Button Content="Zapisz zmiany"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}"
                           Padding="16,6"
                           Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
