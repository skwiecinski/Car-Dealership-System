<ui:FluentWindow x:Class="SalonSamochodowy.Views.FirstConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource FirstConfig_Title}" Height="680" Width="800"
                 WindowStartupLocation="CenterScreen"
                 Background="#16181D"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="SingleBorderWindow"
                 Opacity="0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" />
                    <ThicknessAnimation Storyboard.TargetProperty="Margin" Storyboard.TargetName="MainContentGrid" From="0,20,0,-20" To="0,0,0,0" Duration="0:0:0.6">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid x:Name="MainContentGrid">
            <ui:TitleBar Title="{DynamicResource FirstConfig_HeaderTitle}" VerticalAlignment="Top" />

            <!-- Przyciski zmiany języka -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,50,20,0" Panel.ZIndex="100">
                <Button x:Name="LangPlBtn" Click="LangPl_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" ToolTip="Polski" Cursor="Hand">
                    <Border Width="30" Height="20" CornerRadius="3" ClipToBounds="True" BorderBrush="#5B59E8" BorderThickness="1">
                        <Grid Background="Transparent">
                            <Rectangle Fill="White" Height="10" VerticalAlignment="Top"/>
                            <Rectangle Fill="#DC143C" Height="10" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Button>

                <Button x:Name="LangEnBtn" Click="LangEn_Click" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="English" Cursor="Hand" Opacity="0.4">
                    <Border Width="30" Height="20" CornerRadius="3" ClipToBounds="True" BorderBrush="#2D3038" BorderThickness="1">
                        <Grid Background="Transparent">
                            <Rectangle Fill="White"/>
                            <StackPanel>
                                <Rectangle Fill="#B22234" Height="3.33"/>
                                <Rectangle Fill="White" Height="3.33"/>
                                <Rectangle Fill="#B22234" Height="3.33"/>
                                <Rectangle Fill="White" Height="3.33"/>
                                <Rectangle Fill="#B22234" Height="3.33"/>
                                <Rectangle Fill="White" Height="3.33"/>
                            </StackPanel>
                            <Rectangle Fill="#3C3B6E" Width="12" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Top" Margin="40,50,40,0">
                <ui:SymbolIcon Symbol="Settings24" FontSize="44" Foreground="#5B59E8" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource FirstConfig_MainTitle}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="{DynamicResource FirstConfig_Subtitle}" FontSize="14" Foreground="#8A8D98" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Administrator -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource FirstConfig_AdminData}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource FirstConfig_FirstName}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                                <ui:TextBox Text="{Binding AdminFirstName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_FirstNameHint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource FirstConfig_LastName}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                                <ui:TextBox Text="{Binding AdminLastName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_LastNameHint}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource FirstConfig_Email}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:TextBox Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_EmailHint}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource FirstConfig_Password}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:PasswordBox x:Name="TxtPassword" PlaceholderText="••••••••" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource FirstConfig_BirthDate}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <DatePicker SelectedDate="{Binding AdminBirthDate, Mode=TwoWay}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Dealership -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource FirstConfig_DealershipData}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="{DynamicResource FirstConfig_DealershipName}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:TextBox Text="{Binding DealershipName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_DealershipNameHint}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource FirstConfig_Address}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:TextBox Text="{Binding DealershipAddress, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_AddressHint}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource FirstConfig_City}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:TextBox Text="{Binding DealershipCity, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_CityHint}" Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource FirstConfig_Owner}" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
                        <ui:TextBox Text="{Binding DealershipOwner, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource FirstConfig_OwnerHint}" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#ED6262" FontSize="13" TextWrapping="Wrap" Margin="0,20,0,10" HorizontalAlignment="Center"/>

                <ui:Button Content="{DynamicResource FirstConfig_FinishBtn}"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Width="300"
                           Height="45"
                           FontSize="15"
                           FontWeight="SemiBold"
                           IsDefault="True"
                           Command="{Binding SaveConfigCommand}"
                           CommandParameter="{Binding ElementName=TxtPassword}"/>
            </StackPanel>
        </Grid>

        <!-- Ekran ładowania -->
        <Grid x:Name="LoadingOverlay" Background="#D916181D" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="200">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="60" Height="60" Foreground="#5B59E8" />
                <TextBlock Text="{DynamicResource FirstConfig_Loading}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
