<Page x:Class="SalonSamochodowy.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Klienci" Foreground="White" Background="#1A1C23">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Baza Klientów" FontSize="24" FontWeight="Bold" Foreground="#E2E2E2"/>
                <TextBlock Text="Zarządzanie danymi nabywców i firm" Foreground="#8A8D98"/>
            </StackPanel>
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon PersonAdd24}" Content="Nowy Klient"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Command="{Binding NewClientCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#22242C" CornerRadius="10" BorderBrush="#2D3038" BorderThickness="1">
                <DataGrid ItemsSource="{Binding ClientsList}"
                          SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Imię i Nazwisko / Firma" Binding="{Binding FullName}"    Width="2*"/>
                        <DataGridTextColumn Header="NIP"                     Binding="{Binding TaxId}"       Width="*"/>
                        <DataGridTextColumn Header="Telefon"                 Binding="{Binding PhoneNumber}" Width="*"/>
                        <DataGridTextColumn Header="E-mail"                  Binding="{Binding Email}"       Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <Border Background="#22242C" CornerRadius="10" Padding="20"
                        Visibility="{Binding DetailsVisibility}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Person24" FontSize="40" Margin="0,0,0,15" Foreground="#5B59E8"/>
                        <TextBlock Text="{Binding SelectedClientName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedClientType}" Foreground="#8A8D98" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                        <Separator Background="#2D3038" Margin="0,0,0,20"/>

                        <ui:Button Content="Nowe Zamówienie" Appearance="Primary"  HorizontalAlignment="Stretch" Margin="0,0,0,10" Command="{Binding NewOrderCommand}"/>
                        <ui:Button Content="Edytuj dane"     Appearance="Secondary" HorizontalAlignment="Stretch" Command="{Binding EditClientCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
