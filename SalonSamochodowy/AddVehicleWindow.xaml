<Window x:Class="SalonSamochodowy.AddVehicleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Dodaj nowy pojazd" Height="500" Width="400"
        Background="#1A1C23" Foreground="White"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nowy Pojazd" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="VIN (max 17 znaków)" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ui:TextBox Text="{Binding NewVehicle.VIN}" MaxLength="17" Margin="0,0,0,15" />

            <TextBlock Text="Przebieg (km)" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ui:TextBox Text="{Binding NewVehicle.Mileage}" Margin="0,0,0,15" />

            <CheckBox Content="Pojazd używany" IsChecked="{Binding NewVehicle.IsUsed}" Margin="0,0,0,15" Foreground="White"/>

            <TextBlock Text="Status" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox SelectedItem="{Binding NewVehicle.Status}" Margin="0,0,0,15">
                <ComboBoxItem Content="Dostępny"/>
                <ComboBoxItem Content="Zarezerwowany"/>
                <ComboBoxItem Content="Sprzedany"/>
            </ComboBox>

            <TextBlock Text="Silnik" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox ItemsSource="{Binding AvailableEngines}" 
                      SelectedItem="{Binding SelectedEngine}" 
                      DisplayMemberPath="EngineName"
                      Margin="0,0,0,15"/>

            <TextBlock Text="Wersja wyposażenia (Trim)" Foreground="#8A8D98" Margin="0,0,0,5" FontSize="12"/>
            <ComboBox ItemsSource="{Binding AvailableTrims}" 
                      SelectedItem="{Binding SelectedTrim}" 
                      DisplayMemberPath="TrimName"
                      Margin="0,0,0,15"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Anuluj" 
                       Command="{Binding CancelCommand}" 
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                       Margin="0,0,10,0"/>

            <ui:Button Content="Zapisz" 
                       Appearance="Primary" 
                       Command="{Binding SaveCommand}"
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
    </Grid>
</Window>